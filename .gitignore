# The game's own code and data never go in this repo.
# regen.bat / regen.sh rebuild src/recomp/gen from YOUR disc image.
project/src/recomp/gen/*
!project/src/recomp/gen/.gitkeep
work/
game/
saves/
*.iso
*.xiso
*.xbe

# build output
build*/
*.exe
*.obj
*.o
*.log
framedump.raw
__pycache__/
*.pyc

# game-derived analysis outputs (made from your disc by the tools)
toolkit/tools/*/output/
!toolkit/tools/conformance/test.xbe
dist/

# toolchain fetched by tools/bootstrap.ps1 on a player machine
tools/python/
tools/cmake/
tools/mingw/
tools/ninja/

# The disc's own formats. Nothing in this project should ever hold one:
# the player's files live beside their build, never in the repo. A costume
# texture pack derived from the game's art was committed once, which is
# what this is here to prevent.
*.xpr
*.mpx
*.mpk
*.acs
*.sgd
*.pkx
*.xp2
*.mwa
*.slt
*.scn
*.lit
*.anm
*.wav
*.wmv

# backups left by in-place edits
*.orig
*.bak
